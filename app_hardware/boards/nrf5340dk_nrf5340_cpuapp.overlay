/*
 * nRF5340 DK Devicetree Overlay — app_hardware target
 *
 * Board schematic reference: Nordic nRF5340 DK (PCA10095)
 *
 * Base board DTS (nrf5340_cpuapp_common.dtsi) already defines:
 *   - LEDs: led0 (P0.28), led1 (P0.29), led2 (P0.30), led3 (P0.31)
 *   - Buttons: sw0/button0 (P0.23), sw1/button1 (P0.24), sw2 (P0.08), sw3 (P0.09)
 *   - Watchdog: &wdt0, alias watchdog0
 *   - UART0: console on VCOM0 (TX=P0.20, RX=P0.22, RTS=P0.19, CTS=P0.21, 115200 baud)
 *            with both default and sleep pinctrl states.
 *
 * This overlay exposes the script_uart alias pointing to uart0 for the
 * serial Python script streamer protocol, without conflicting with or duplicating
 * board definitions or corrupting uart0 pinctrl states.
 */

/ {
	aliases {
		script-uart = &uart0;
	};
};

